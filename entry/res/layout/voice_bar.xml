<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vbRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/vbCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bar_bg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/vbDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_glow" />

            <TextView
                android:id="@+id/vbHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="正在听…"
                android:textColor="#9FE1CB"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/vbTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="再按音量▾执行"
                android:textColor="#5F7A70"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/vbClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="12dp"
                android:paddingBottom="2dp"
                android:text="×"
                android:textColor="#6E8F84"
                android:textSize="16sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/vbInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_bg"
            android:hint="说一句，它就去做…"
            android:imeOptions="actionSend"
            android:inputType="text|textCapSentences"
            android:maxLines="2"
            android:minLines="1"
            android:padding="12dp"
            android:textColor="#EAF5F0"
            android:textColorHint="#5F7A70"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
