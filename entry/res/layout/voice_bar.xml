<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vbRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 全屏灰幕：80% 深灰半透明遮罩（压掉背景文字/图标/色块，背景隐约可见但不抢眼） -->
    <View
        android:id="@+id/vbDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC4A4A4A" />

    <!-- 全屏四边光效层（仅绘制，不拦截触摸） -->
    <com.xiaogongtou.entry.GlowFrameView
        android:id="@+id/vbGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 内容层：无卡片无底衬——声波线 + 识别文字 +（确认时）动作按钮；无任何提示文案 -->
    <LinearLayout
        android:id="@+id/vbCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp">

        <!-- 声波线：说话中随音量波动；静息时一条细线 -->
        <com.xiaogongtou.entry.WaveView
            android:id="@+id/vbWave"
            android:layout_width="300dp"
            android:layout_height="86dp" />

        <!-- 识别结果（"我的输入"；点按可手动修改） -->
        <EditText
            android:id="@+id/vbInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:gravity="center"
            android:imeOptions="actionSend"
            android:inputType="text|textCapSentences"
            android:maxLines="6"
            android:minHeight="92dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:shadowColor="#E6000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="14"
            android:textColorHint="#B3DCE8F5"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 动作行（待确认时显示） -->
        <LinearLayout
            android:id="@+id/vbBtns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/vbRetry"
                android:layout_width="112dp"
                android:layout_height="46dp"
                android:background="@drawable/vb_btn_ghost"
                android:gravity="center"
                android:text="重说"
                android:textColor="#9FB6D9"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/vbSubmit"
                android:layout_width="132dp"
                android:layout_height="46dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/vb_btn_submit"
                android:gravity="center"
                android:text="提交"
                android:textColor="#EAF6FF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
